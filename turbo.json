{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["NODE_ENV"],
  "globalDependencies": ["tsconfig.json"],
  "cacheMaxSize": "1GB",
  "tasks": {
    "lint": {
      "inputs": [
        "**/*.ts",
        "!.agents/skills/**/*.ts",
        "!dist/**/*.js",
        "!node_modules/**/*.ts"
      ],
      "cache": true
    },
    "knip": {
      "cache": true
    },
    "test:coverage": {
      "cache": true
    },
    "test": {
      "cache": true
    },
    "test:unit": {
      "cache": true
    },
    "build": {
      "cache": true,
      "outputs": [".svelte-kit/output/**/*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
