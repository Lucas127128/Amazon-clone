{
  "name": "web",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#pages/*": "./src/scripts/pages/*",
    "#utils/*": "./src/scripts/utils/*",
    "#data/*": "./src/scripts/data/*",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "sync": "svelte-kit sync",
    "build": "bunx -b vite build",
    "dev": "vite",
    "preview": "bunx -b vite preview",
    "test": "bunx -b vitest -w false",
    "test:watch": "bunx -b vitest -w",
    "test:coverage": "bunx -b vitest -w false --coverage",
    "test:unit": "bun run test --exclude **/*/scripts/data/orders.test.ts --exclude **/*/paymentSummary.test.ts "
  },
  "dependencies": {
    "@ark-ui/svelte": "^5.24.0",
    "@sveltejs/adapter-auto": "^8.0.0-next.3",
    "@sveltejs/kit": "^3.0.0-next.25",
    "cnfast": "^0.1.0",
    "effect": "catalog:",
    "fuse.js": "^7.5.0",
    "nanoid": "^6.0.1",
    "svelte": "^5.56.10",
    "temporal-polyfill-lite": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "comptime": "^0.1.0",
    "happy-dom": "catalog:",
    "sonda": "^0.14.0",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "testdata": "workspace:*",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
