{
  "name": "web",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#pages/*": "./src/scripts/pages/*",
    "#utils/*": "./src/scripts/utils/*",
    "#data/*": "./src/scripts/data/*",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "check": "bunx -b svelte-check --tsconfig ./tsconfig.json",
    "build": "NODE_TLS_REJECT_UNAUTHORIZED=0 bunx -b vite build",
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 vite",
    "preview": "NODE_TLS_REJECT_UNAUTHORIZED=0 bunx -b vite preview",
    "test": "bunx -b vitest -w false",
    "test:watch": "bunx -b vitest -w",
    "test:coverage": "bunx -b vitest -w false --coverage",
    "test:unit": "bun run test --exclude **/*/scripts/data/orders.test.ts --exclude **/*/paymentSummary.test.ts "
  },
  "dependencies": {
    "@ark-ui/svelte": "^5.24.0",
    "@sveltejs/adapter-auto": "^8.0.0-next.3",
    "@sveltejs/kit": "^3.0.0-next.23",
    "@tanstack/pacer-lite": "^0.2.2",
    "api-client": "workspace:*",
    "cnfast": "^0.1.0",
    "effect": "catalog:",
    "nanoid": "^6.0.1",
    "shared": "workspace:*",
    "svelte": "^5.56.9",
    "temporal-polyfill-lite": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/devtools": "^0.4.1",
    "@vitest/ui": "catalog:",
    "comptime": "^0.1.0",
    "happy-dom": "catalog:",
    "sonda": "^0.14.0",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "testdata": "workspace:*",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
