{
  "name": "amazon-clone",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#lib/*": "./src/lib/*",
    "#testdata": "./testData/index.ts"
  },
  "scripts": {
    "lint": "bunx -b oxlint -c ./oxlint.config.ts",
    "fmt": "oxfmt",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "sync": "svelte-kit sync",
    "dev": "vite",
    "preview": "bunx -b vite preview",
    "test": "bunx -b vitest -w false",
    "test:watch": "bunx -b vitest -w",
    "test:coverage": "bunx -b vitest -w false --coverage",
    "build": "bunx -b vite build",
    "knip": "knip-bun",
    "pre-commit": "bunx turbo run lint knip test:unit check"
  },
  "dependencies": {
    "@ark-ui/svelte": "^5.24.0",
    "@sveltejs/adapter-auto": "^8.0.0-next.3",
    "@sveltejs/kit": "^3.0.0-next.25",
    "cnfast": "^0.1.0",
    "effect": "^4.0.0-rc.112",
    "fuse.js": "^7.5.0",
    "nanoid": "^6.0.1",
    "svelte": "^5.56.10",
    "temporal-polyfill-lite": "^0.4.2",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@socketsecurity/bun-security-scanner": "^1.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.4.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "comptime": "^0.1.0",
    "eslint-plugin-depend": "^1.5.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-turbo": "^2.10.12",
    "eslint-plugin-typed-rocks": "^1.0.8",
    "happy-dom": "^20.11.8",
    "husky": "^9.1.7",
    "knip": "^6.32.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "sonda": "^0.14.0",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.12",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "comptime@0.1.0": "patches/comptime@0.1.0.patch"
  }
}
